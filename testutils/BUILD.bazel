load("@rules_java//java:defs.bzl", "java_library")
load("//bazel:errorprone.bzl", "NO_ERRORPRONE_OPTS")

java_library(
    name = "testutils",
    srcs = glob(["src/main/java/**/*.java"]),
    # The Gradle build compiles this module without ErrorProne.
    javacopts = NO_ERRORPRONE_OPTS,
    visibility = ["//visibility:public"],
    deps = [
        "//rhino",
        "@maven//:junit_junit",
    ],
)
