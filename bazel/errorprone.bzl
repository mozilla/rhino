LIBRARY_OPTS = DEFAULT_OPTS + [
    "-Xlint:deprecation",
    "-Xlint:unchecked",
    "-Xlint:-removal",
] + [
    # Same disabled checks as the Gradle build
    "-Xep:%s:OFF" % c
    for c in DISABLED_CHECKS
] + [
    # Same enabled-by-default checks as the Gradle build
    "-Xep:%s:WARN" % c
    for c in DEFAULT_WARNING_CHECKS
] + [
    # Same additional checks as the Gradle build. Both have default severity
    # SUGGESTION, so they are enabled but do not produce output.
    "-Xep:RemoveUnusedImports",
    "-Xep:WildcardImport",
]

TEST_OPTS = [
    # The Gradle build excludes test sources from ErrorProne entirely.
    "-XepDisableAllChecks",
    "-Xlint:deprecation",
    "-Xlint:unchecked",
    "-Xlint:-removal",
]

# For targets that the Gradle build compiles without ErrorProne at all.
