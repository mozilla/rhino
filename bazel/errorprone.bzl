# This file contains the ErrorProne configuration shared by the Bazel build.
# It mirrors the ErrorProne configuration of the Gradle build (see
# buildSrc/src/main/groovy/rhino.library-conventions.gradle) so that both
# builds report the same warnings.
#
# Note that Bazel's built-in ErrorProne (bundled with the rules_java JDK
# toolchain) only runs the checks whose default severity is ERROR, while
# the Gradle build runs all checks whose default severity is ERROR or
# WARNING. DEFAULT_WARNING_CHECKS below therefore enables the
# WARNING-severity checks explicitly. It is the list of checks that are
# enabled by default in error_prone_core 2.45.0 (the version used by the
# Gradle build) with a default severity of WARNING, minus DISABLED_CHECKS.

DEFAULT_OPTS = [
    "-XepAllErrorsAsWarnings",
]

# Checks that the Gradle build disables ("checks we aren't ready to fix yet")
